<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".pertemuan_4.DashboardP4Activity"
    android:padding="30dp"
    android:background="@color/white">

    <TextView
        android:id="@+id/tvJudulMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dashboard Utama"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvDescMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pilih menu di bawah ini untuk berpindah halaman."
        android:textColor="@color/text_gray"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvJudulMain"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/btnBangunRuang"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="1. Rumus Bangun Ruang"
        app:layout_constraintBottom_toTopOf="@+id/btnCustom1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <Button
        android:id="@+id/btnCustom1"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:text="2. Custom 1 (Figma Dashboard)"
        app:layout_constraintBottom_toTopOf="@+id/btnCustom2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnBangunRuang" />

    <Button
        android:id="@+id/btnCustom2"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:text="3. Custom 2 (Figma Splash)"
        app:layout_constraintBottom_toTopOf="@+id/btnLogout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnCustom1" />

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:text="4. Logout"
        android:backgroundTint="#F44336"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnCustom2" />

</androidx.constraintlayout.widget.ConstraintLayout>